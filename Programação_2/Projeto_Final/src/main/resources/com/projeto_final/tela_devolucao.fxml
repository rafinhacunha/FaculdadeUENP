<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="400.0" prefWidth="600.0" 
            xmlns="http://javafx.com/javafx/24.0.1" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.projeto_final.ControllerDevolucao">
    
   <children>
      <!-- Título -->
      <Label layoutX="180.0" layoutY="60.0" text="Registro de Devoluções" 
             style="-fx-font-weight: bold;">
         <font>
            <Font size="22.0" />
         </font>
      </Label>
      
      <!-- Label Retiradas -->
      <Label layoutX="150.0" layoutY="130.0" text="Retiradas:" 
             style="-fx-font-weight: bold;">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      
      <!-- ComboBox Retiradas -->
      <ComboBox fx:id="comboRetiradas" layoutX="230.0" layoutY="125.0" 
                prefWidth="220.0" prefHeight="30.0"
                promptText="Selecione uma retirada"/>
      
      <!-- Mensagem -->
      <Label fx:id="lblAviso" layoutX="100.0" layoutY="190.0" 
             prefHeight="25.0" prefWidth="400.0" 
             alignment="CENTER" wrapText="true"/>
      
      <!-- Botões -->
      <Button layoutX="200.0" layoutY="250.0" mnemonicParsing="false" 
              onAction="#cancelar" prefHeight="35.0" prefWidth="100.0" 
              text="Voltar">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      
      <Button layoutX="320.0" layoutY="250.0" mnemonicParsing="false" 
              onAction="#gravar" prefHeight="35.0" prefWidth="100.0" 
              text="Gravar">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>