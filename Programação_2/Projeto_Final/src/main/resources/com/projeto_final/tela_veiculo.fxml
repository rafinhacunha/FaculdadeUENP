<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="400.0" prefWidth="600.0" 
            xmlns="http://javafx.com/javafx/24.0.1" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.projeto_final.ControllerVeiculo">
    
   <children>
      <!-- Título -->
      <Text layoutX="170.0" layoutY="60.0" strokeType="OUTSIDE" strokeWidth="0.0" 
            text="Registro de Veículo" wrappingWidth="260.0">
         <font>
            <Font size="28.0" />
         </font>
      </Text>
      
      <!-- Campo Placa -->
      <Text layoutX="140.0" layoutY="125.0" strokeType="OUTSIDE" strokeWidth="0.0" 
            text="Placa:" style="-fx-font-weight: bold;">
         <font>
            <Font size="14.0" />
         </font>
      </Text>
      <TextField fx:id="txtPlaca" layoutX="200.0" layoutY="110.0" 
                 prefHeight="30.0" prefWidth="260.0" 
                 promptText="Ex: ABC-1234"/>
      
      <!-- Campo Marca -->
      <Text layoutX="140.0" layoutY="175.0" strokeType="OUTSIDE" strokeWidth="0.0" 
            text="Marca:" style="-fx-font-weight: bold;">
         <font>
            <Font size="14.0" />
         </font>
      </Text>
      <TextField fx:id="txtMarca" layoutX="200.0" layoutY="160.0" 
                 prefHeight="30.0" prefWidth="260.0" 
                 promptText="Ex: Ford, Toyota"/>
      
      <!-- Campo Modelo -->
      <Text layoutX="140.0" layoutY="225.0" strokeType="OUTSIDE" strokeWidth="0.0" 
            text="Modelo:" style="-fx-font-weight: bold;">
         <font>
            <Font size="14.0" />
         </font>
      </Text>
      <TextField fx:id="txtModelo" layoutX="200.0" layoutY="210.0" 
                 prefHeight="30.0" prefWidth="260.0" 
                 promptText="Ex: Fiesta, Corolla"/>
      
      <!-- Mensagem -->
      <Label fx:id="lblAviso" layoutX="150.0" layoutY="260.0" 
             prefHeight="25.0" prefWidth="300.0" 
             alignment="CENTER" wrapText="true"/>
      
      <!-- Botões -->
      <Button layoutX="200.0" layoutY="300.0" mnemonicParsing="false" 
              onAction="#voltar" prefHeight="35.0" prefWidth="120.0" 
              text="Voltar">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      
      <Button layoutX="340.0" layoutY="300.0" mnemonicParsing="false" 
              onAction="#registrar_veiculo" prefHeight="35.0" prefWidth="120.0" 
              text="Registrar">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>