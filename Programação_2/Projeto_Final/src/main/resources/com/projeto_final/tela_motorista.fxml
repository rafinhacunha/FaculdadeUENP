<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="400.0" prefWidth="600.0" 
            xmlns="http://javafx.com/javafx/24.0.1" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.projeto_final.ControllerMotorista">
    
   <children>
      <!-- Título -->
      <Text layoutX="150.0" layoutY="55.0" strokeType="OUTSIDE" strokeWidth="0.0" 
            text="Registro de Motorista" wrappingWidth="300.0">
         <font>
            <Font size="26.0" />
         </font>
      </Text>
      
      <!-- Campo Código -->
      <Text layoutX="120.0" layoutY="105.0" strokeType="OUTSIDE" strokeWidth="0.0" 
            text="Código:" style="-fx-font-weight: bold;">
         <font>
            <Font size="14.0" />
         </font>
      </Text>
      <TextField fx:id="txtCodigo" layoutX="200.0" layoutY="90.0" 
                 prefHeight="30.0" prefWidth="280.0" 
                 promptText="Código do motorista"/>
      
      <!-- Campo Nome -->
      <Text layoutX="120.0" layoutY="155.0" strokeType="OUTSIDE" strokeWidth="0.0" 
            text="Nome:" style="-fx-font-weight: bold;">
         <font>
            <Font size="14.0" />
         </font>
      </Text>
      <TextField fx:id="txtNome" layoutX="200.0" layoutY="140.0" 
                 prefHeight="30.0" prefWidth="280.0" 
                 promptText="Nome completo"/>
      
      <!-- Campo CNH -->
      <Text layoutX="120.0" layoutY="205.0" strokeType="OUTSIDE" strokeWidth="0.0" 
            text="CNH:" style="-fx-font-weight: bold;">
         <font>
            <Font size="14.0" />
         </font>
      </Text>
      <TextField fx:id="txtCNH" layoutX="200.0" layoutY="190.0" 
                 prefHeight="30.0" prefWidth="280.0" 
                 promptText="Número da CNH"/>
      
      <!-- Campo Setor -->
      <Text layoutX="120.0" layoutY="255.0" strokeType="OUTSIDE" strokeWidth="0.0" 
            text="Setor:" style="-fx-font-weight: bold;">
         <font>
            <Font size="14.0" />
         </font>
      </Text>
      <TextField fx:id="txtSetor" layoutX="200.0" layoutY="240.0" 
                 prefHeight="30.0" prefWidth="280.0" 
                 promptText="Ex: Direção, Hospital"/>
      
      <!-- Mensagem -->
      <Label fx:id="lblAviso" layoutX="120.0" layoutY="285.0" 
             prefHeight="25.0" prefWidth="360.0" 
             alignment="CENTER" wrapText="true"/>
      
      <!-- Botões -->
      <Button layoutX="190.0" layoutY="330.0" mnemonicParsing="false" 
              onAction="#voltar" prefHeight="35.0" prefWidth="100.0" 
              text="Voltar">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      
      <Button layoutX="310.0" layoutY="330.0" mnemonicParsing="false" 
              onAction="#registrar_motorista" prefHeight="35.0" prefWidth="100.0" 
              text="Registrar">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>