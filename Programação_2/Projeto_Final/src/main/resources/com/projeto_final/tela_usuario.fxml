<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="400.0" prefWidth="600.0" 
            xmlns="http://javafx.com/javafx/24.0.1" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.projeto_final.ControllerUsuario">
    
   <children>
      <!-- Título -->
      <Text layoutX="150.0" layoutY="50.0" strokeType="OUTSIDE" strokeWidth="0.0" 
            text="Cadastro de Usuário" wrappingWidth="300.0">
         <font>
            <Font size="26.0" />
         </font>
      </Text>
      
      <!-- Campos em linha única (label + field) -->
      <!-- Nome -->
      <Label layoutX="100.0" layoutY="110.0" text="Nome:" 
             style="-fx-font-weight: bold;">
         <font>
            <Font size="13.0" />
         </font>
      </Label>
      <TextField fx:id="txtNome" layoutX="170.0" layoutY="105.0" 
                 prefHeight="32.0" prefWidth="330.0" 
                 promptText="Nome completo"/>
      
      <!-- Login -->
      <Label layoutX="100.0" layoutY="160.0" text="Login:" 
             style="-fx-font-weight: bold;">
         <font>
            <Font size="13.0" />
         </font>
      </Label>
      <TextField fx:id="txtLogin" layoutX="170.0" layoutY="155.0" 
                 prefHeight="32.0" prefWidth="330.0" 
                 promptText="Nome de usuário"/>
      
      <!-- Senha -->
      <Label layoutX="100.0" layoutY="210.0" text="Senha:" 
             style="-fx-font-weight: bold;">
         <font>
            <Font size="13.0" />
         </font>
      </Label>
      <TextField fx:id="txtSenha" layoutX="170.0" layoutY="205.0" 
                 prefHeight="32.0" prefWidth="330.0" 
                 promptText="Senha de acesso"/>
      
      <!-- Mensagem -->
      <Label fx:id="lblAviso" layoutX="100.0" layoutY="260.0" 
             prefHeight="25.0" prefWidth="400.0" 
             alignment="CENTER" wrapText="true"/>
      
      <!-- Botões centralizados -->
      <Button layoutX="180.0" layoutY="310.0" mnemonicParsing="false" 
              onAction="#voltar" prefHeight="36.0" prefWidth="100.0" 
              text="Voltar">
         <font>
            <Font size="13.0" />
         </font>
      </Button>
      
      <Button layoutX="320.0" layoutY="310.0" mnemonicParsing="false" 
              onAction="#registrar_usuario" prefHeight="36.0" prefWidth="100.0" 
              text="Cadastrar">
         <font>
            <Font size="13.0" />
         </font>
      </Button>
   </children>
</AnchorPane>