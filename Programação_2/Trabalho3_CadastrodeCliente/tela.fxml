<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>


<AnchorPane xmlns:fx="http://javafx.com/fxml" 
            fx:controller="com.mycompany.trabalho.controller.ClienteController">
    <children>
        <TextField fx:id="txtNome" layoutX="50" layoutY="20" promptText="Nome"/>
        <TextField fx:id="txtTelefone" layoutX="50" layoutY="60" promptText="Telefone"/>
        <TextField fx:id="txtCep" layoutX="50" layoutY="100" promptText="CEP"/>
        <Button text="Buscar" layoutX="220" layoutY="100" onAction="#buscarCep"/>
        <TextField fx:id="txtRua" layoutX="50" layoutY="140" promptText="Rua"/>
        <TextField fx:id="txtNumero" layoutX="300" layoutY="140" promptText="Número"/>
        <TextField fx:id="txtCidade" layoutX="50" layoutY="180" promptText="Cidade"/>
        <TextField fx:id="txtEstado" layoutX="300" layoutY="180" promptText="Estado"/>
        <Button text="Cadastrar" layoutX="50" layoutY="220" onAction="#cadastrarCliente"/>
        <TableView fx:id="tabelaClientes" layoutX="50" layoutY="270" prefWidth="600" prefHeight="200">
            <columns>
                <TableColumn fx:id="colunaCodigo" text="Código"/>
                <TableColumn fx:id="colunaNome" text="Nome"/>
                <TableColumn fx:id="colunaTelefone" text="Telefone"/>
                <TableColumn fx:id="colunaRua" text="Rua"/>
                <TableColumn fx:id="colunaCidade" text="Cidade"/>
                <TableColumn fx:id="colunaEstado" text="Estado"/>
            </columns>
        </TableView>
    </children>
</AnchorPane>
